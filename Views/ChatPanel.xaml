<UserControl x:Class="LuKnight.Views.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320"
             Height="360">

    <Border Background="#FFFDF9"
            BorderBrush="#DDD6CC"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14">

        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="3"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="2,0,2,10">

                <TextBlock Text="Mimo"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#403A34"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,3,0,0">

                    <Ellipse x:Name="StatusDot"
                             Width="7"
                             Height="7"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="#AAA39A"/>

                    <TextBlock x:Name="StatusText"
                               Text="Menyiapkan..."
                               FontSize="11"
                               Foreground="#80776E"/>

                </StackPanel>

            </StackPanel>

            <!-- Percakapan -->
            <ScrollViewer x:Name="MessagesScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12">

                <StackPanel x:Name="MessagesPanel"/>

            </ScrollViewer>

            <!-- Input -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Height="38"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         BorderBrush="#CCC4B9"
                         BorderThickness="1"
                         KeyDown="MessageInput_KeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Width="58"
                        Height="38"
                        Margin="8,0,0,0"
                        Content="Kirim"
                        Click="SendButton_Click"/>

            </Grid>

        </Grid>

    </Border>

</UserControl>
