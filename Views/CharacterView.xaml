<UserControl x:Class="LuKnight.Views.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="170"
             Height="220"
             Background="Transparent"
             Cursor="SizeAll"
             Loaded="CharacterView_Loaded"
             MouseRightButtonDown="CharacterView_MouseRightButtonDown">

    <UserControl.Resources>

        <!-- ====================== -->
        <!-- IDLE ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="IdleStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas pelan -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.025"
                Duration="0:0:1.5"/>

            <!-- Naik sedikit -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-2"
                Duration="0:0:1.5"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- WALK ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="WalkStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Badan memantul -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-6"
                Duration="0:0:0.22"/>

            <!-- Sedikit miring -->
            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-2"
                To="2"
                Duration="0:0:0.22"/>

            <!-- Kaki kiri -->
            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-15"
                To="15"
                Duration="0:0:0.22"/>

            <!-- Kaki kanan -->
            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="15"
                To="-15"
                Duration="0:0:0.22"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- SLEEP ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="SleepStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas tidur lebih lambat -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.035"
                Duration="0:0:2.5"/>

            <DoubleAnimation
                Storyboard.TargetName="SleepText"
                Storyboard.TargetProperty="Opacity"
                From="0.25"
                To="1"
                Duration="0:0:2"/>

        </Storyboard>

    </UserControl.Resources>


    <Grid Background="Transparent">

        <!-- Semua bagian karakter ada di dalam container ini -->
        <Grid x:Name="CharacterRoot"
              RenderTransformOrigin="0.5,0.75">

            <Grid.RenderTransform>
                <TransformGroup>

                    <ScaleTransform x:Name="BodyScale"
                                    ScaleX="1"
                                    ScaleY="1"/>

                    <RotateTransform x:Name="BodyRotate"
                                     Angle="0"/>

                    <TranslateTransform x:Name="BodyTranslate"
                                        X="0"
                                        Y="0"/>

                </TransformGroup>
            </Grid.RenderTransform>


            <!-- Bayangan -->
            <Ellipse Width="115"
                     Height="20"
                     Fill="#25000000"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,4"/>


            <!-- Kaki kiri -->
            <Ellipse Width="37"
                     Height="55"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="45,0,0,8"
                     RenderTransformOrigin="0.5,0.1">

                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="LeftFootRotate"
                                     Angle="0"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <!-- Kaki kanan -->
            <Ellipse Width="37"
                     Height="55"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,45,8"
                     RenderTransformOrigin="0.5,0.1">

                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="RightFootRotate"
                                     Angle="0"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <!-- Tubuh -->
            <Ellipse Width="120"
                     Height="125"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,18"/>


            <!-- Telinga kiri -->
            <Ellipse Width="42"
                     Height="72"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="24,15,0,0"
                     RenderTransformOrigin="0.5,0.5">

                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-22"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <!-- Telinga kanan -->
            <Ellipse Width="42"
                     Height="72"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,15,24,0"
                     RenderTransformOrigin="0.5,0.5">

                <Ellipse.RenderTransform>
                    <RotateTransform Angle="22"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <!-- Kepala -->
            <Ellipse Width="145"
                     Height="125"
                     Fill="#FFF0D2"
                     Stroke="#5B5147"
                     StrokeThickness="3"
                     VerticalAlignment="Top"
                     Margin="0,43,0,0"/>


            <!-- Mata normal -->
            <Grid x:Name="AwakeEyes">

                <Ellipse Width="12"
                         Height="17"
                         Fill="#433C36"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="53,91,0,0"/>

                <Ellipse Width="12"
                         Height="17"
                         Fill="#433C36"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,91,53,0"/>

            </Grid>


            <!-- Mata tidur -->
            <Grid x:Name="SleepEyes"
                  Visibility="Collapsed">

                <Border Width="22"
                        Height="8"
                        BorderBrush="#433C36"
                        BorderThickness="0,0,0,3"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="45,92,0,0"/>

                <Border Width="22"
                        Height="8"
                        BorderBrush="#433C36"
                        BorderThickness="0,0,0,3"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,92,45,0"/>

            </Grid>


            <!-- Hidung -->
            <Ellipse Width="9"
                     Height="7"
                     Fill="#8B6557"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,116,0,0"/>


            <!-- Mulut -->
            <Border Width="23"
                    Height="12"
                    BorderBrush="#6A554A"
                    BorderThickness="0,0,0,3"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,121,0,0"/>


            <!-- Zzz -->
            <TextBlock x:Name="SleepText"
                       Text="Zzz"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#6F6B88"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,32,3,0"
                       Opacity="0"
                       Visibility="Collapsed"/>

        </Grid>

    </Grid>

</UserControl>