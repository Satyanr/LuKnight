<UserControl x:Class="LuKnight.Views.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="170"
             Height="220"
             Background="Transparent"
             Cursor="SizeAll"
             Loaded="CharacterView_Loaded"
             MouseRightButtonDown="CharacterView_MouseRightButtonDown">

    <UserControl.Resources>

        <!-- ====================== -->
        <!-- IDLE ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="IdleStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas pelan -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.025"
                Duration="0:0:1.5"/>

            <!-- Naik sedikit -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-2"
                Duration="0:0:1.5"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- WALK ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="WalkStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Badan memantul -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-6"
                Duration="0:0:0.22"/>

            <!-- Sedikit miring -->
            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-2"
                To="2"
                Duration="0:0:0.22"/>

            <!-- Kaki kiri -->
            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-15"
                To="15"
                Duration="0:0:0.22"/>

            <!-- Kaki kanan -->
            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="15"
                To="-15"
                Duration="0:0:0.22"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- SLEEP ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="SleepStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas tidur lebih lambat -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.035"
                Duration="0:0:2.5"/>

            <DoubleAnimation
                Storyboard.TargetName="SleepText"
                Storyboard.TargetProperty="Opacity"
                From="0.25"
                To="1"
                Duration="0:0:2"/>

        </Storyboard>

    </UserControl.Resources>


    <Grid Background="Transparent">

        <!-- Semua bagian karakter ada di dalam container ini -->
        <Grid x:Name="CharacterRoot"
              RenderTransformOrigin="0.5,0.72">

            <Grid.RenderTransform>
                <TransformGroup>

                    <ScaleTransform x:Name="BodyScale"
                                    ScaleX="1"
                                    ScaleY="1"/>

                    <RotateTransform x:Name="BodyRotate"
                                     Angle="0"/>

                    <TranslateTransform x:Name="BodyTranslate"
                                        X="0"
                                        Y="0"/>

                </TransformGroup>
            </Grid.RenderTransform>


            <!-- Shadow -->
            <Ellipse Width="105"
                     Height="15"
                     Fill="#220F172A"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,5"/>


            <!-- Tail -->
            <Ellipse Width="29"
                     Height="29"
                     Fill="#F8FBFF"
                     Stroke="#334155"
                     StrokeThickness="3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,18,38"/>


            <!-- Feet -->

            <Ellipse Width="38"
                     Height="25"
                     Fill="#F8FBFF"
                     Stroke="#334155"
                     StrokeThickness="3"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="44,0,0,8"
                     RenderTransformOrigin="0.5,0.2">

                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="LeftFootRotate"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <Ellipse Width="38"
                     Height="25"
                     Fill="#F8FBFF"
                     Stroke="#334155"
                     StrokeThickness="3"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,44,8"
                     RenderTransformOrigin="0.5,0.2">

                <Ellipse.RenderTransform>
                    <RotateTransform x:Name="RightFootRotate"/>
                </Ellipse.RenderTransform>

            </Ellipse>


            <!-- Body -->

            <Border Width="103"
                    Height="87"
                    Background="#F8FBFF"
                    BorderBrush="#334155"
                    BorderThickness="3"
                    CornerRadius="48"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,23"/>


            <!-- Knight chest emblem -->

            <Grid Width="22"
                  Height="22"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,68">

                <Polygon Points="11,1 20,11 11,21 2,11"
                         Fill="#72B7F2"
                         Stroke="#334155"
                         StrokeThickness="2"/>

                <Ellipse Width="5"
                         Height="5"
                         Fill="#F8FBFF"/>

            </Grid>


            <!-- LEFT EAR -->

            <Border Width="34"
                    Height="86"
                    Background="#F8FBFF"
                    BorderBrush="#334155"
                    BorderThickness="3"
                    CornerRadius="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="35,8,0,0"
                    RenderTransformOrigin="0.5,0.85">

                <Border.RenderTransform>
                    <RotateTransform Angle="-10"/>
                </Border.RenderTransform>

                <Border Width="15"
                        Height="57"
                        Background="#BFE3FF"
                        CornerRadius="10"
                        VerticalAlignment="Center"/>

            </Border>


            <!-- RIGHT EAR -->

            <Border Width="34"
                    Height="86"
                    Background="#F8FBFF"
                    BorderBrush="#334155"
                    BorderThickness="3"
                    CornerRadius="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,35,0"
                    RenderTransformOrigin="0.5,0.85">

                <Border.RenderTransform>
                    <RotateTransform Angle="10"/>
                </Border.RenderTransform>

                <Border Width="15"
                        Height="57"
                        Background="#BFE3FF"
                        CornerRadius="10"
                        VerticalAlignment="Center"/>

            </Border>


            <!-- HEAD -->

            <Border Width="142"
                    Height="116"
                    Background="#F8FBFF"
                    BorderBrush="#334155"
                    BorderThickness="3"
                    CornerRadius="58"
                    VerticalAlignment="Top"
                    Margin="0,62,0,0"/>


            <!-- Cheeks -->

            <Ellipse Width="20"
                     Height="10"
                     Fill="#D7ECFF"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="35,129,0,0"/>

            <Ellipse Width="20"
                     Height="10"
                     Fill="#D7ECFF"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,129,35,0"/>


            <!-- Awake Eyes -->

            <Grid x:Name="AwakeEyes">

                <Ellipse Width="10"
                         Height="14"
                         Fill="#263548"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="49,105,0,0"/>

                <Ellipse Width="10"
                         Height="14"
                         Fill="#263548"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,105,49,0"/>

                <!-- eye highlights -->

                <Ellipse Width="3"
                         Height="3"
                         Fill="White"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="52,107,0,0"/>

                <Ellipse Width="3"
                         Height="3"
                         Fill="White"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,107,52,0"/>

            </Grid>


            <!-- Sleep Eyes -->

            <Grid x:Name="SleepEyes"
                  Visibility="Collapsed">

                <Border Width="18"
                        Height="7"
                        BorderBrush="#263548"
                        BorderThickness="0,0,0,3"
                        CornerRadius="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="45,108,0,0"/>

                <Border Width="18"
                        Height="7"
                        BorderBrush="#263548"
                        BorderThickness="0,0,0,3"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,108,45,0"/>

            </Grid>


            <!-- Nose -->

            <Ellipse Width="7"
                     Height="5"
                     Fill="#72B7F2"
                     VerticalAlignment="Top"
                     Margin="0,127,0,0"/>


            <!-- Mouth -->

            <TextBlock Text="ᴗ"
                       Foreground="#334155"
                       FontSize="17"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,128,0,0"/>


            <!-- Small Lu mark -->

            <TextBlock Text="✦"
                       FontSize="12"
                       Foreground="#72B7F2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,82,25,0"/>


            <!-- Sleep indicator -->

            <TextBlock x:Name="SleepText"
                       Text="Zzz"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#72B7F2"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,35,2,0"
                       Opacity="0"
                       Visibility="Collapsed"/>

        </Grid>
    </Grid>

</UserControl>