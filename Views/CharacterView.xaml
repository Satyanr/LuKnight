<UserControl x:Class="LuKnight.Views.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="170"
             Height="220"
             Background="Transparent"
             Cursor="SizeAll"
             Loaded="CharacterView_Loaded"
             Unloaded="CharacterView_Unloaded"
             MouseRightButtonDown="CharacterView_MouseRightButtonDown">

    <UserControl.Resources>

        <Storyboard x:Key="SpriteIdleStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="SpriteScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.018"
                             Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="SpriteTranslate"
                             Storyboard.TargetProperty="Y"
                             From="0"
                             To="-1.8"
                             Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="SpriteRotate"
                             Storyboard.TargetProperty="Angle"
                             From="-0.7"
                             To="0.7"
                             Duration="0:0:2.2"/>
        </Storyboard>

        <!-- ====================== -->
        <!-- BLINK -->
        <!-- ====================== -->
        <Storyboard x:Key="BlinkStoryboard">

            <DoubleAnimation
                Storyboard.TargetName="EyeBlinkScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="0.08"
                Duration="0:0:0.07"
                AutoReverse="True"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- EAR TWITCH -->
        <!-- ====================== -->
        <Storyboard x:Key="EarTwitchStoryboard"
                    FillBehavior="Stop">

            <DoubleAnimation
                Storyboard.TargetName="LeftEarRotate"
                Storyboard.TargetProperty="Angle"
                By="9"
                Duration="0:0:0.12"
                AutoReverse="True"/>

            <DoubleAnimation
                Storyboard.TargetName="RightEarRotate"
                Storyboard.TargetProperty="Angle"
                By="-9"
                Duration="0:0:0.12"
                BeginTime="0:0:0.04"
                AutoReverse="True"/>

        </Storyboard>

        <!-- ====================== -->
        <!-- IDLE ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="IdleStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas pelan -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.025"
                Duration="0:0:1.5"/>

            <!-- Naik sedikit -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-2"
                Duration="0:0:1.5"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- WALK ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="WalkStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Badan memantul -->
            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-6"
                Duration="0:0:0.22"/>

            <!-- Sedikit miring -->
            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-2"
                To="2"
                Duration="0:0:0.22"/>

            <!-- Kaki kiri -->
            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-15"
                To="15"
                Duration="0:0:0.22"/>

            <!-- Kaki kanan -->
            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="15"
                To="-15"
                Duration="0:0:0.22"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- SLEEP ANIMATION -->
        <!-- ====================== -->
        <Storyboard x:Key="SleepStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- Napas tidur lebih lambat -->
            <DoubleAnimation
                Storyboard.TargetName="BodyScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.035"
                Duration="0:0:2.5"/>

            <DoubleAnimation
                Storyboard.TargetName="SleepText"
                Storyboard.TargetProperty="Opacity"
                From="0.25"
                To="1"
                Duration="0:0:2"/>

        </Storyboard>

        <Storyboard x:Key="ThinkingStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetName="EmblemScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.05"
                To="1.28"
                Duration="0:0:0.65"/>

            <DoubleAnimation
                Storyboard.TargetName="EmblemScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.05"
                To="1.28"
                Duration="0:0:0.65"/>

            <DoubleAnimation
                Storyboard.TargetName="EmblemGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.20"
                To="0.80"
                Duration="0:0:0.65"/>

        </Storyboard>

        <Storyboard x:Key="HappyReactionStoryboard"
                    FillBehavior="Stop">

            <DoubleAnimation
                Storyboard.TargetName="MoodTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="-7"
                Duration="0:0:0.14"
                AutoReverse="True"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.03"
                To="1.08"
                Duration="0:0:0.14"
                AutoReverse="True"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.03"
                To="1.08"
                Duration="0:0:0.14"
                AutoReverse="True"/>

        </Storyboard>

        <Storyboard x:Key="SurpriseReactionStoryboard"
                    FillBehavior="Stop">

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleX"
                From="1"
                To="1.09"
                Duration="0:0:0.10"
                AutoReverse="True"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="1.09"
                Duration="0:0:0.10"
                AutoReverse="True"/>

        </Storyboard>

        <!-- ====================== -->
        <!-- GRABBED -->
        <!-- ====================== -->

        <Storyboard x:Key="GrabbedStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- tubuh menggantung -->
            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-3"
                To="3"
                Duration="0:0:0.30"/>

            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="4"
                Duration="0:0:0.30"/>


            <!-- tangan menggantung -->

            <DoubleAnimation
                Storyboard.TargetName="LeftArmRotate"
                Storyboard.TargetProperty="Angle"
                From="30"
                To="40"
                Duration="0:0:0.34"/>

            <DoubleAnimation
                Storyboard.TargetName="RightArmRotate"
                Storyboard.TargetProperty="Angle"
                From="-30"
                To="-40"
                Duration="0:0:0.34"/>


            <!-- kaki menggantung -->

            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-5"
                To="9"
                Duration="0:0:0.32"/>

            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="5"
                To="-9"
                Duration="0:0:0.32"/>


            <!-- telinga ikut lemas -->

            <DoubleAnimation
                Storyboard.TargetName="LeftEarRotate"
                Storyboard.TargetProperty="Angle"
                From="-10"
                To="-4"
                Duration="0:0:0.40"/>

            <DoubleAnimation
                Storyboard.TargetName="RightEarRotate"
                Storyboard.TargetProperty="Angle"
                From="10"
                To="4"
                Duration="0:0:0.40"/>

        </Storyboard>

        <!-- ====================== -->
        <!-- FALLING -->
        <!-- ====================== -->

        <Storyboard x:Key="FallingStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-7"
                To="7"
                Duration="0:0:0.45"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- LANDING -->
        <!-- ====================== -->

        <Storyboard x:Key="LandingReactionStoryboard"
                    FillBehavior="Stop">

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.10"
                To="1"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.82"
                To="1"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodTranslate"
                Storyboard.TargetProperty="Y"
                From="5"
                To="0"
                Duration="0:0:0.22"/>

        </Storyboard>

        <!-- ====================== -->
        <!-- DIZZY -->
        <!-- ====================== -->

        <Storyboard x:Key="DizzyStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetName="DizzyEyeRotate"
                Storyboard.TargetProperty="Angle"
                From="-4"
                To="4"
                Duration="0:0:0.16"/>

            <DoubleAnimation
                Storyboard.TargetName="DizzyEyeTranslate"
                Storyboard.TargetProperty="X"
                From="-2"
                To="2"
                Duration="0:0:0.12"/>

            <DoubleAnimation
                Storyboard.TargetName="MoodRotate"
                Storyboard.TargetProperty="Angle"
                From="-5"
                To="5"
                Duration="0:0:0.22"/>

        </Storyboard>

        <!-- ====================== -->
        <!-- HANGING -->
        <!-- ====================== -->

        <Storyboard x:Key="HangingStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <!-- badan bergoyang -->
            <DoubleAnimation
                Storyboard.TargetName="BodyRotate"
                Storyboard.TargetProperty="Angle"
                From="-2"
                To="2"
                Duration="0:0:0.55"/>

            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="0"
                To="3"
                Duration="0:0:0.55"/>


            <!-- tangan menggapai ke atas -->

            <DoubleAnimation
                Storyboard.TargetName="LeftArmRotate"
                Storyboard.TargetProperty="Angle"
                From="88"
                To="96"
                Duration="0:0:0.42"/>

            <DoubleAnimation
                Storyboard.TargetName="RightArmRotate"
                Storyboard.TargetProperty="Angle"
                From="-88"
                To="-96"
                Duration="0:0:0.42"/>


            <!-- kaki menggantung -->

            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-18"
                To="8"
                Duration="0:0:0.48"/>

            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="18"
                To="-8"
                Duration="0:0:0.48"/>


            <!-- telinga turun -->

            <DoubleAnimation
                Storyboard.TargetName="LeftEarRotate"
                Storyboard.TargetProperty="Angle"
                From="-8"
                To="-2"
                Duration="0:0:0.65"/>

            <DoubleAnimation
                Storyboard.TargetName="RightEarRotate"
                Storyboard.TargetProperty="Angle"
                From="8"
                To="2"
                Duration="0:0:0.65"/>

        </Storyboard>


        <!-- ====================== -->
        <!-- CLIMBING -->
        <!-- ====================== -->

        <Storyboard x:Key="ClimbingStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

            <DoubleAnimation
                Storyboard.TargetName="BodyTranslate"
                Storyboard.TargetProperty="Y"
                From="4"
                To="-8"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="LeftArmRotate"
                Storyboard.TargetProperty="Angle"
                From="95"
                To="70"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="RightArmRotate"
                Storyboard.TargetProperty="Angle"
                From="-70"
                To="-95"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="LeftFootRotate"
                Storyboard.TargetProperty="Angle"
                From="-18"
                To="18"
                Duration="0:0:0.22"/>

            <DoubleAnimation
                Storyboard.TargetName="RightFootRotate"
                Storyboard.TargetProperty="Angle"
                From="18"
                To="-18"
                Duration="0:0:0.22"/>

        </Storyboard>

    </UserControl.Resources>


    <Grid Background="Transparent">

        <!-- Semua bagian karakter ada di dalam container ini -->
        <!-- SPRITE / SOFT-3D RENDERER -->
        <Grid x:Name="SpriteLayer"
              Visibility="Collapsed"
              IsHitTestVisible="False">

            <Grid x:Name="SpriteImpactRoot"
                  RenderTransformOrigin="0.5,0.88">

                <Grid.RenderTransform>

                    <TransformGroup>

                        <ScaleTransform
                            x:Name="SpriteImpactScale"
                            ScaleX="1"
                            ScaleY="1"/>

                        <RotateTransform
                            x:Name="SpriteImpactRotate"
                            Angle="0"/>

                        <TranslateTransform
                            x:Name="SpriteImpactTranslate"
                            X="0"
                            Y="0"/>

                    </TransformGroup>

                </Grid.RenderTransform>


                <Image x:Name="SpriteImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       RenderTransformOrigin="0.5,0.88"
                       RenderOptions.BitmapScalingMode="HighQuality">

                    <Image.RenderTransform>

                        <TransformGroup>

                            <ScaleTransform
                                x:Name="SpriteScale"
                                ScaleX="1"
                                ScaleY="1"/>

                            <RotateTransform
                                x:Name="SpriteRotate"
                                Angle="0"/>

                            <TranslateTransform
                                x:Name="SpriteTranslate"
                                X="0"
                                Y="0"/>

                            <RotateTransform
                                x:Name="SpriteAttentionRotate"
                                Angle="0"/>

                            <TranslateTransform
                                x:Name="SpriteAttentionTranslate"
                                X="0"
                                Y="0"/>

                        </TransformGroup>

                    </Image.RenderTransform>

                </Image>

            </Grid>

        </Grid>
        <!-- CURRENT VECTOR RENDERER -->
        <Grid x:Name="VectorLayer">
            <Grid x:Name="CharacterRoot"
                  RenderTransformOrigin="0.5,0.72">

                <Grid.RenderTransform>
                    <TransformGroup>

                        <!-- movement / facing -->
                        <ScaleTransform x:Name="BodyScale"
                                        ScaleX="1"
                                        ScaleY="1"/>

                        <!-- emotion squash/stretch -->
                        <ScaleTransform x:Name="MoodScale"
                                        ScaleX="1"
                                        ScaleY="1"/>

                        <!-- walk rotation -->
                        <RotateTransform x:Name="BodyRotate"
                                         Angle="0"/>

                        <!-- emotion head/body tilt -->
                        <RotateTransform x:Name="MoodRotate"
                                         Angle="0"/>

                        <!-- movement -->
                        <TranslateTransform x:Name="BodyTranslate"
                                            X="0"
                                            Y="0"/>

                        <!-- reaction bounce -->
                        <TranslateTransform x:Name="MoodTranslate"
                                            X="0"
                                            Y="0"/>

                    </TransformGroup>
                </Grid.RenderTransform>


                <!-- ============================= -->
                <!-- SHADOW -->
                <!-- ============================= -->

                <Ellipse Width="96"
                         Height="12"
                         Fill="#240B1830"
                         VerticalAlignment="Bottom"
                         Margin="0,0,0,4"/>


                <!-- ============================= -->
                <!-- EARS -->
                <!-- ============================= -->

                <!-- Left ear -->
                <Border Width="39"
                        Height="94"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.5"
                        CornerRadius="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="23,-2,0,0"
                        RenderTransformOrigin="0.5,0.9">

                    <Border.RenderTransform>
                        <RotateTransform x:Name="LeftEarRotate"
                                         Angle="-24"/>
                    </Border.RenderTransform>

                    <Border Width="16"
                            Height="67"
                            Margin="0,10,0,5"
                            Background="#BCEEFF"
                            CornerRadius="10"/>

                </Border>


                <!-- Right ear -->
                <Border Width="39"
                        Height="98"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.5"
                        CornerRadius="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,20,0"
                        RenderTransformOrigin="0.5,0.9">

                    <Border.RenderTransform>
                        <RotateTransform x:Name="RightEarRotate"
                                         Angle="27"/>
                    </Border.RenderTransform>

                    <Border Width="16"
                            Height="70"
                            Margin="0,10,0,5"
                            Background="#BCEEFF"
                            CornerRadius="10"/>

                </Border>


                <!-- ============================= -->
                <!-- BODY -->
                <!-- ============================= -->

                <Border Width="75"
                        Height="72"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.5"
                        CornerRadius="36"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,28"/>


                <!-- ============================= -->
                <!-- ARMS -->
                <!-- ============================= -->

                <Border Width="57"
                        Height="25"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.5"
                        CornerRadius="15"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="17,0,0,62"
                        RenderTransformOrigin="0.85,0.5">

                    <Border.RenderTransform>
                        <RotateTransform x:Name="LeftArmRotate"
                                         Angle="-18"/>
                    </Border.RenderTransform>

                </Border>


                <Border Width="57"
                        Height="25"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.5"
                        CornerRadius="15"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,17,62"
                        RenderTransformOrigin="0.15,0.5">

                    <Border.RenderTransform>
                        <RotateTransform x:Name="RightArmRotate"
                                         Angle="18"/>
                    </Border.RenderTransform>

                </Border>


                <!-- ============================= -->
                <!-- FEET -->
                <!-- ============================= -->

                <Ellipse Width="31"
                         Height="38"
                         Fill="#FCFCFF"
                         Stroke="#3A455B"
                         StrokeThickness="2.5"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="50,0,0,7"
                         RenderTransformOrigin="0.5,0.15">

                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="LeftFootRotate"
                                         Angle="-8"/>
                    </Ellipse.RenderTransform>

                </Ellipse>


                <Ellipse Width="31"
                         Height="38"
                         Fill="#FCFCFF"
                         Stroke="#3A455B"
                         StrokeThickness="2.5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,50,7"
                         RenderTransformOrigin="0.5,0.15">

                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="RightFootRotate"
                                         Angle="8"/>
                    </Ellipse.RenderTransform>

                </Ellipse>


                <!-- ============================= -->
                <!-- CHEST EMBLEM -->
                <!-- ============================= -->

                <Grid x:Name="ChestEmblem"
                      Width="24"
                      Height="24"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,63"
                      RenderTransformOrigin="0.5,0.5">

                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="EmblemScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Grid.RenderTransform>


                    <!-- glow -->
                    <Ellipse x:Name="EmblemGlow"
                             Width="36"
                             Height="36"
                             Fill="#5570C9F4"
                             Opacity="0"/>


                    <Polygon Points="12,1 22,12 12,23 2,12"
                             Fill="#70C9F4"
                             Stroke="#40516A"
                             StrokeThickness="1.8"/>

                    <Ellipse Width="5"
                             Height="5"
                             Fill="White"/>

                </Grid>


                <!-- ============================= -->
                <!-- HEAD -->
                <!-- ============================= -->

                <Border Width="151"
                        Height="124"
                        Background="#FCFCFF"
                        BorderBrush="#3A455B"
                        BorderThickness="2.7"
                        CornerRadius="64"
                        VerticalAlignment="Top"
                        Margin="0,56,0,0">


                    <Border.Effect>
                        <DropShadowEffect BlurRadius="7"
                                          ShadowDepth="1"
                                          Opacity="0.15"/>
                    </Border.Effect>

                </Border>


                <!-- ============================= -->
                <!-- EYES -->
                <!-- ============================= -->

                <Grid x:Name="AwakeEyes"
                      RenderTransformOrigin="0.5,0.5">

                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="EyeBlinkScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Grid.RenderTransform>


                    <!-- ========================= -->
                    <!-- STATIC EYE SOCKETS -->
                    <!-- ========================= -->

                    <Ellipse Width="52"
                             Height="57"
                             Fill="#AEEBF2"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="25,82,0,0"/>

                    <Ellipse Width="52"
                             Height="57"
                             Fill="#AEEBF2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,82,25,0"/>


                    <!-- ========================= -->
                    <!-- MOVING EYEBALL LAYER -->
                    <!-- ========================= -->

                    <Grid x:Name="EyeLookLayer">

                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="EyeLookTranslate"
                                                X="0"
                                                Y="0"/>
                        </Grid.RenderTransform>


                        <!-- Black eyes -->

                        <Ellipse Width="43"
                                 Height="50"
                                 Fill="#151923"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="30,85,0,0"/>

                        <Ellipse Width="43"
                                 Height="50"
                                 Fill="#151923"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,85,30,0"/>


                        <!-- Big highlights -->

                        <Ellipse Width="13"
                                 Height="17"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="38,92,0,0"/>

                        <Ellipse Width="13"
                                 Height="17"
                                 Fill="White"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,92,38,0"/>


                        <!-- Diamond pupils -->

                        <Polygon Points="7,0 14,7 7,14 0,7"
                                 Width="14"
                                 Height="14"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="49,108,0,0"/>

                        <Polygon Points="7,0 14,7 7,14 0,7"
                                 Width="14"
                                 Height="14"
                                 Fill="White"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,108,49,0"/>


                        <!-- Tiny gloss -->

                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="#DDF8FF"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="56,96,0,0"/>

                        <Ellipse Width="5"
                                 Height="5"
                                 Fill="#DDF8FF"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,96,56,0"/>

                    </Grid>

                </Grid>

                <!-- ============================= -->
                <!-- DIZZY EYES OVERLAY -->
                <!-- ============================= -->

                <Grid x:Name="DizzyEyes"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">

                    <Grid.RenderTransform>
                        <TransformGroup>

                            <RotateTransform x:Name="DizzyEyeRotate"
                                             Angle="0"/>

                            <TranslateTransform x:Name="DizzyEyeTranslate"
                                                X="0"
                                                Y="0"/>

                        </TransformGroup>
                    </Grid.RenderTransform>


                    <!-- menutup pupil normal tetapi mempertahankan ring cyan -->

                    <Ellipse Width="43"
                             Height="50"
                             Fill="#151923"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="30,85,0,0"/>

                    <Ellipse Width="43"
                             Height="50"
                             Fill="#151923"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,85,30,0"/>


                    <!-- X eyes -->

                    <TextBlock Text="×"
                               Width="43"
                               Height="50"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="30,87,0,0"/>

                    <TextBlock Text="×"
                               Width="43"
                               Height="50"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,87,30,0"/>

                </Grid>

                <!-- ============================= -->
                <!-- SLEEP EYES -->
                <!-- ============================= -->

                <Grid x:Name="SleepEyes"
                      Visibility="Collapsed">

                    <Border Width="35"
