<Window x:Class="LuKnight.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lu-Knight Settings" Width="860" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#0F172A" Foreground="#E2E8F0"
        FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="3,0" Background="#435770" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A3B2C7"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F1F5F9"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#152035"/><Setter Property="BorderBrush" Value="#27364C"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#22334D"/><Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3D536F"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#2B4561"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#67E8F9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#155E75"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/><Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/><Setter Property="Margin" Value="0,5,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="18" Height="18" VerticalAlignment="Center" BorderBrush="#758AA7" Background="#0F172A" BorderThickness="1" CornerRadius="4">
                        <Path x:Name="Tick" Visibility="Collapsed" Data="M 3,8 L 6,11 L 13,4" Stroke="#082F49" StrokeThickness="2"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#67E8F9"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#B6C4D7"/><Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1D2B43"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#17384B"/><Setter Property="Foreground" Value="#67E8F9"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#67E8F9"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="SettingsRoot" Background="#0F172A">
        <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#111C30" BorderBrush="#26354C" BorderThickness="0,0,1,0">
            <Grid Margin="18,28,18,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Lu-Knight" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Desktop companion" FontSize="12" Foreground="#67E8F9" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox x:Name="Navigation" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectedValuePath="Tag" SelectedValue="{Binding SelectedSection, Mode=TwoWay}" VerticalAlignment="Top" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Settings sections">
                    <ListBoxItem Tag="General" Content="General"/>
                    <ListBoxItem Tag="Behavior" Content="Behavior"/>
                    <ListBoxItem Tag="AI &amp; Chat" Content="AI &amp; Chat"/>
                    <ListBoxItem Tag="About" Content="About"/>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="10,0,0,0">
                    <TextBlock Text="LU-KNIGHT SETTINGS" FontSize="10" Foreground="#8295AE"/>
                    <TextBlock Text="{Binding Version, StringFormat=Version {0}}" FontSize="12" Foreground="#A3B2C7" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,26,28,18">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                <Grid>
                    <StackPanel x:Name="GeneralPanel">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="General"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="General" Style="{StaticResource Title}"/>
                        <TextBlock Text="Atur tampilan dan akses ke teman desktop Anda." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                            <TextBlock Text="Desktop companion" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top" IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>
                            <CheckBox x:Name="ShowCharacterCheck" Content="Show Lu-Knight" IsChecked="{Binding CharacterVisible, Mode=TwoWay}"/>
                            <Button x:Name="ResetPositionButton" Content="Reset character position" Command="{Binding ResetPositionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            <TextBlock Text="Tampilkan karakter kembali di tengah pijakan desktop." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}" Padding="16"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="Renderer" Style="{StaticResource Muted}"/><TextBlock x:Name="RendererText" Text="{Binding Renderer}" Foreground="#67E8F9" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Application status" Style="{StaticResource Muted}"/><TextBlock Text="{Binding ApplicationStatus}" Foreground="#D7E8F8" Margin="0,6,0,0"/></StackPanel>
                        </Grid></Border>
                        <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                            <TextBlock Text="Startup" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="StartupCheck" Content="Start Lu-Knight with Windows" IsEnabled="{Binding StartupAvailable}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                            <CheckBox x:Name="StartHiddenCheck" Content="Start hidden in System Tray" IsEnabled="{Binding StartupAvailable}" IsChecked="{Binding StartHidden, Mode=TwoWay}" ToolTip="Mulai tersembunyi hanya berlaku saat login Windows. Membuka aplikasi secara manual tetap menampilkan karakter."/>
                            <TextBlock Text="{Binding StartupMessage}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="BehaviorPanel">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="Behavior"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Behavior" Style="{StaticResource Title}"/>
                        <TextBlock Text="Cara Lu-Knight bergerak, beristirahat, dan bereaksi." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <CheckBox x:Name="AutonomousCheck" Content="Enable autonomous behavior" IsChecked="{Binding AutonomousEnabled}"/>
                            <TextBlock Text="Saat nonaktif, drag, lempar, klik, chat, dan interaksi cursor tetap tersedia." Style="{StaticResource Muted}"/>
                            <Grid Margin="0,16,0,0" IsEnabled="{Binding AutonomousEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Activity level" Margin="0,0,0,6"/><ComboBox x:Name="ActivityCombo" ItemsSource="{Binding ActivityChoices}" SelectedItem="{Binding Activity}" ToolTip="Calm lebih sering diam; Active lebih sering berjalan dan menjelajah."/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Movement speed" Margin="0,0,0,6"/><ComboBox x:Name="SpeedCombo" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding Speed}"/></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Sleep" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="AllowSleepCheck" Content="Allow Lu-Knight to sleep" IsEnabled="{Binding AutonomousEnabled}" IsChecked="{Binding AllowSleep}"/>
                            <Grid Margin="0,8,0,0" IsEnabled="{Binding SleepControlsEnabled}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Sleep after" Margin="0,0,0,6"/><ComboBox x:Name="SleepAfterCombo" ItemsSource="{Binding SleepChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SleepAfter}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Nap duration" Margin="0,0,0,6"/><ComboBox x:Name="NapCombo" ItemsSource="{Binding NapChoices}" SelectedItem="{Binding Nap}"/></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Window adventures" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="ExploreWindowsCheck" Content="Explore application windows" IsEnabled="{Binding AutonomousEnabled}" IsChecked="{Binding ExploreWindows}"/>
                            <CheckBox x:Name="JumpWindowsCheck" Content="Jump between windows" IsEnabled="{Binding AdventureControlsEnabled}" IsChecked="{Binding JumpBetweenWindows}"/>
                            <CheckBox x:Name="HangingCheck" Content="Hanging / climbing" IsEnabled="{Binding AdventureControlsEnabled}" IsChecked="{Binding HangingClimbing}"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Cursor interaction" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="LookCursorCheck" Content="Look at cursor" IsChecked="{Binding LookAtCursor}"/>
                            <CheckBox x:Name="ReactCursorCheck" Content="React when cursor approaches" IsChecked="{Binding ReactToCursor}"/>
                            <CheckBox x:Name="WakeCursorCheck" Content="Wake when cursor approaches" IsChecked="{Binding WakeAtCursor}"/>
                        </StackPanel></Border>
                        <Button x:Name="ResetBehaviorButton" Content="Reset Behavior to Default" Command="{Binding ResetBehaviorCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Perubahan langsung berlaku dan tersimpan otomatis." Style="{StaticResource Muted}" Margin="0,12,0,16"/>
                    </StackPanel>
                    <StackPanel x:Name="AiPanel">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="AI &amp; Chat"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="AI &amp; Chat" Style="{StaticResource Title}"/>
                        <TextBlock Text="Status layanan yang sedang digunakan oleh Lu-Knight." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="AI status" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="AiStatusText" Text="{Binding Product.ChatStatus}" Foreground="#67E8F9" TextWrapping="Wrap"/>
                            <StackPanel IsEnabled="{Binding Product.CanEditChat}" Margin="0,16,0,0">
                                <TextBlock Text="Provider" Margin="0,0,0,6"/><ComboBox x:Name="ProviderCombo" ItemsSource="{Binding Product.Providers}" SelectedItem="{Binding Product.Provider}"/>
                                <TextBlock Text="AI model" Margin="0,14,0,6"/><TextBox x:Name="ModelInput" Text="{Binding Product.Model, UpdateSourceTrigger=LostFocus}" Padding="10,7" Foreground="#0F172A"/>
                            </StackPanel>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding Product.CanEditChat}">
                            <TextBlock Text="API key" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding Product.CredentialStatus}" Style="{StaticResource Muted}"/>
                            <PasswordBox x:Name="ApiKeyInput" Margin="0,12,0,10" Padding="10,7" Foreground="#0F172A" ToolTip="Masukkan key baru. Key yang tersimpan tidak ditampilkan kembali."/>
                            <WrapPanel><Button Content="Update Key" Click="UpdateKey_Click" Margin="0,0,8,8"/><Button Content="Remove Key" Command="{Binding Product.RemoveKeyCommand}" Margin="0,0,8,8"/><Button Content="Test Connection" Command="{Binding Product.TestCommand}" Margin="0,0,0,8"/></WrapPanel>
                            <TextBlock Text="Key tersimpan di Windows Credential Manager. Jika key tersimpan dihapus, environment GEMINI_API_KEY tetap dapat dipakai sebagai fallback." Style="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel IsEnabled="{Binding Product.CanEditChat}">
                            <TextBlock Text="Conversation" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Language" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Product.Languages}" SelectedItem="{Binding Product.Language}"/>
                            <TextBlock Text="Response length" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding Product.Lengths}" SelectedItem="{Binding Product.Length}"/>
                            <TextBlock Text="Response style" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding Product.Styles}" SelectedItem="{Binding Product.Style}"/>
                            <CheckBox Content="Use recent conversation as AI context" IsChecked="{Binding Product.Remember}" Margin="0,18,0,12"/>
                            <Button Content="Clear Conversation" Command="{Binding Product.ClearCommand}" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Long-term memory" Style="{StaticResource CardTitle}"/>
                            <CheckBox Content="Use saved long-term memory as AI context" IsEnabled="{Binding Product.CanEditChat}" IsChecked="{Binding Product.UseLongTermMemory, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding Product.LongTermMemorySummary}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Product.LongTermMemoryStatus}" Foreground="#67E8F9" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Content="Clear Long-Term Memory" Click="ClearLongTermMemory_Click" IsEnabled="{Binding Product.CanClearLongTermMemory}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <TextBlock Text="Clear Conversation hanya menghapus percakapan sesi. Clear Long-Term Memory menghapus memory.json yang disimpan Lu-Knight." Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Application awareness" Style="{StaticResource CardTitle}"/>
                                <CheckBox Content="Allow Lu-Knight to use visible application context" IsEnabled="{Binding Product.CanEditChat}" IsChecked="{Binding Product.UseApplicationContext, Mode=TwoWay}"/>
                                <TextBlock Text="Lu-Knight hanya menerima nama process dan kategori aplikasi. Isi layar, judul window, nama dokumen, clipboard, dan isi file belum dibaca." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="File context" Style="{StaticResource CardTitle}"/>
                                <CheckBox Content="Allow Lu-Knight to read explicitly requested text files" IsEnabled="{Binding Product.CanEditChat}" IsChecked="{Binding Product.UseFileContext, Mode=TwoWay}"/>
                                <TextBlock Text="Hanya file yang Anda sebutkan secara eksplisit. Lu-Knight tidak memindai folder. Isi file digunakan untuk request saat itu dan tidak disimpan ke long-term memory." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="AboutPanel">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedSection}" Value="About"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="About" Style="{StaticResource Title}"/>
                        <TextBlock Text="Teman kecil untuk aktivitas sehari-hari di desktop." Style="{StaticResource Muted}" Margin="0,0,0,22"/>
                        <Border Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="Lu-Knight" FontSize="30" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="AI Desktop Companion" Foreground="#67E8F9" Margin="0,6,0,22"/>
                            <TextBlock Text="Version" Style="{StaticResource Muted}"/><TextBlock x:Name="VersionText" Text="{Binding Version}" Margin="0,5,0,16"/>
                            <TextBlock Text="Build" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Build}" Margin="0,5,0,20"/>
                            <TextBlock><Hyperlink NavigateUri="{Binding RepositoryUrl}" RequestNavigate="Repository_RequestNavigate" Foreground="#67E8F9">GitHub · Satyanr/LuKnight</Hyperlink></TextBlock>
                            <TextBlock Text="{Binding Copyright}" Style="{StaticResource Muted}" Margin="0,20,0,0"/>
                        </StackPanel></Border>
                        <WrapPanel>
                            <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Command="{Binding Product.CheckCommand}" IsEnabled="{Binding Product.CanCheck, FallbackValue=False}" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                            <Button Content="Download Update" Command="{Binding Product.DownloadCommand}" Margin="0,0,8,8"/>
                            <Button Content="Install &amp; Restart" Command="{Binding Product.InstallCommand}" Margin="0,0,8,8"/>
                            <Button Content="Later" Command="{Binding Product.LaterCommand}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Product.UpdateStatus}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <TextBlock Text="Pemeriksaan otomatis maksimal sekali sehari. Update hanya dipasang saat Anda memilih Install &amp; Restart dan karakter tidak sedang drag, jatuh, atau chat." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button Content="Save" Command="{Binding Product.SaveCommand}" DockPanel.Dock="Right" Padding="12,5"/><TextBlock Text="{Binding Product.SaveStatus, FallbackValue='Pengaturan sesi'}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
        </Grid>
    </Grid>
</Window>
