<Window x:Class="LuKnight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LuKnight.Views"

        Title="Lu-Knight"
        Width="190"
        Height="240"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"

        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <Grid Background="Transparent">

        <views:CharacterView
            x:Name="CharacterControl"

            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MouseEnter="Character_MouseEnter"
            MouseLeave="Character_MouseLeave"
            LostMouseCapture="Character_LostMouseCapture"

            PreviewMouseLeftButtonDown=
                "Character_PreviewMouseLeftButtonDown"

            PreviewMouseMove=
                "Character_PreviewMouseMove"

            PreviewMouseLeftButtonUp=
                "Character_PreviewMouseLeftButtonUp"/>


        <!--
            Popup memiliki window sendiri.
            Jadi panel chat tidak memperbesar area transparan
            window karakter.
        -->

        <Popup x:Name="ChatPopup"
               PlacementTarget="{Binding ElementName=CharacterControl}"
               Placement="Right"
               HorizontalOffset="12"
               VerticalOffset="-60"
               AllowsTransparency="True"
               StaysOpen="True">

            <views:ChatPanel x:Name="ChatPanelControl"/>

        </Popup>

    </Grid>

</Window>